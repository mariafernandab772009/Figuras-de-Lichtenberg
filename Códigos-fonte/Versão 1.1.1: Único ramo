# CODIGO EXPORTAR EM GIF

import numpy as np
import matplotlib.pyplot as plt
import matplotlib.animation as animation
import sys

# Lista de entradas visitadas (agora inicializada vazia e preenchida dinamicamente)
travelled = []

class LeastResistance:
    def __init__(self, grid):
        # Recebe o grid adequadamente no inicializador
        self.grid = grid
        self.rows = len(grid)
        self.columns = len(grid[0])

        # Todas as 8 direções (exceto [-1, -1] como definido originalmente)
        self.directions = [[1, 1], [1, 0], [0, 1], [1, -1], [-1, 1], [0, -1], [-1, 0]]

    def updateOrder(self, row, col):
        global travelled

        # Dicionário de todas as entradas vizinhas possíveis de (row, col)
        coords = {}

        # Busca todas as direções usando o laço for
        for x, y in self.directions:
            new_row, new_col = row + x, col + y

            # Grava a direção viajada (chave) e o novo valor do grid (valor) no dicionário
            if (0 <= new_row < self.rows and 0 <= new_col < self.columns and (new_row, new_col) not in travelled):
                coords[(x, y)] = self.grid[new_row][new_col]

        # Se o dicionário estiver vazio, o algoritmo não tem para onde ir e termina
        if not coords:
            return True

        else:
            # Chave do menor valor de entrada em coords
            get_min = min(coords, key=coords.get)

            new_row, new_col = row + get_min[0], col + get_min[1]
            travelled.append((new_row, new_col))

            # Se o algoritmo alcança uma entrada de zero, ele termina
            if self.grid[new_row][new_col] == 0:
                return True

            # Chamada recursiva
            else:
                # O Python possui limite de recursão, aumentamos se a malha for grande
                sys.setrecursionlimit(max(sys.getrecursionlimit(), self.rows * self.columns))
                return self.updateOrder(new_row, new_col)


# --- Entradas do Usuário ---
# Utilizando os parâmetros recomendados: 100, 100, 1, 200 e 0,0
print('Insira o número de linhas, e.g.: 100:')
x_row = int(input())

print('Insira o número de colunas, e.g.: 100:')
y_col = int(input())

print('Insira o valor mínimo de resistência, e.g.: 1:')
min_res = float(input())

print('Insira o valor máximo de resistência, e.g.: 200:')
max_res = float(input())

print('Insira a posição inicial, e.g.: 0, 0:')
x_input, y_input = input().split(",")
x_input = int(x_input.strip())
y_input = int(y_input.strip())

# Configura a posição inicial real
travelled.append((x_input, y_input))

# --- Inicialização do Algoritmo ---
grid = np.random.randint(min_res, max_res, size=(x_row, y_col))
current = LeastResistance(grid)
current.updateOrder(x_input, y_input)
print(f"Caminho percorrido possui {len(travelled)} passos.")

# --- Animação ---
empty = np.zeros((x_row, y_col))
fig, ax = plt.subplots()

def animate(i):
    # Atualiza a matriz vazia com o passo atual
    empty[travelled[i][0]][travelled[i][1]] = i + 100
    ax.clear()
    # Remove as marcações de eixo para ficar mais bonito esteticamente
    ax.set_xticks([])
    ax.set_yticks([])
    # Renderiza a matriz
    ax.matshow(empty, cmap='Blues')

# Gera a animação
ani = animation.FuncAnimation(fig, animate, frames=len(travelled), interval=50, repeat=False)

# SALVA A ANIMAÇÃO
print("Salvando animação como UnicoRamo.gif... Aguarde.")
ani.save('UnicoRamo.gif', writer='pillow', fps=15)
print("Animação salva com sucesso!")
